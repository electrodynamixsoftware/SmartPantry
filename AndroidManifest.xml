<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No location, maps or internet permissions: the app is strictly pantry + recipe matching. -->

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="Smart Pantry Manager"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartPantry">

        <activity
            android:name=".ui.PantryListActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.AddEditItemActivity" android:exported="false" />
        <activity android:name=".ui.SuggestedRecipesActivity" android:exported="false" />
        <activity android:name=".ui.RecipeDetailActivity" android:exported="false" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" />
    </application>

</manifest>
